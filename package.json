{
  "name": "odessyus-agent",
  "version": "2.0.18",
  "description": "Odessyus - Autonomous ReAct-Driven Sports Forecasting & Betting Agent",
  "type": "module",
  "scripts": {
    "dev": "npx concurrently \"npm run server\" \"npm run client\"",
    "server": "unset PUPPETEER_TOKEN SCRAPER_TOKEN && tsx watch server/index.ts",
    "client": "vite --port 5000 --host 0.0.0.0",
    "build": "npm run build:all",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:browser": "cd browser && npm install --no-audit --no-fund && PUPPETEER_CACHE_DIR=/opt/render/project/.chrome npx puppeteer browsers install chrome",
    "build:all": "npm run build:browser && npm run build:client && npm run build:server",
    "preview": "vite preview",
    "start": "npm run build:server && unset PUPPETEER_TOKEN SCRAPER_TOKEN && node dist-server/index.js"
  },
  "dependencies": {
    "@mistralai/mistralai": "^1.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.5.4",
    "cheerio": "^1.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.0",
    "helmet": "^7.1.0",
    "lucide-react": "^0.400.0",
    "mysql2": "^3.23.1",
    "node-cron": "^3.0.3",
    "pg": "^8.22.0",
    "puppeteer-core": "^24.43.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.3",
    "tailwindcss": "^4.3.3",
    "telegraf": "^4.16.3",
    "typescript": "^5.5.3",
    "uuid": "^10.0.0",
    "vite": "^5.3.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.10",
    "clsx": "^2.1.1",
    "concurrently": "^8.2.2",
    "tsx": "^4.16.2"
  }
}
